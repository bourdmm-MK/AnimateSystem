    "distance":      { "hex": "#D147BD", "manim": "PINK" },
    "velocity":      { "hex": "#F7D96F", "manim": "YELLOW" },
    "acceleration":  { "hex": "#5CD0B3", "manim": "TEAL" },
    "axes":          { "hex": "#83C167", "manim": "GREEN" },
